# Host ports. Change these if port 3000 or 5432 is already in use.
APP_PORT=3000
POSTGRES_PORT=5432

# Local Docker database. Use URL-safe characters in the password because
# compose.yaml places it inside DATABASE_URL.
POSTGRES_DB=bookleaf
POSTGRES_USER=bookleaf
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Use an HTTPS origin for a real production deployment.
BETTER_AUTH_URL=http://localhost:3000

# Optional server-only classification. Gemini 3.5 Flash-Lite is the trial
# default. Leave provider/key empty when AI is intentionally unavailable;
# ticket creation still succeeds.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_MS=5000
LLM_MAX_RETRIES=1
