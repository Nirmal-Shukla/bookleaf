generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  AUTHOR
  ADMIN

  @@map("user_role")
}


enum TicketStatus {
  OPEN        @map("Open")
  IN_PROGRESS @map("In Progress")
  RESOLVED    @map("Resolved")
  CLOSED      @map("Closed")

  @@map("ticket_status")
}


enum TicketCategory {
  ROYALTY_PAYMENTS               @map("Royalty & Payments")
  ISBN_METADATA_ISSUES           @map("ISBN & Metadata Issues")
  PRINTING_QUALITY               @map("Printing & Quality")
  DISTRIBUTION_AVAILABILITY      @map("Distribution & Availability")
  BOOK_STATUS_PRODUCTION_UPDATES @map("Book Status & Production Updates")
  GENERAL_INQUIRY                @map("General Inquiry")

  @@map("ticket_category")
}

enum TicketPriority {
  CRITICAL @map("Critical")
  HIGH     @map("High")
  MEDIUM   @map("Medium")
  LOW      @map("Low")

  @@map("ticket_priority")
}

enum ClassificationState {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("classification_state")
}

enum ClassificationSource {
  AI
  ADMIN

  @@map("classification_source")
}

enum AiTaskType {
  CLASSIFICATION
  RESPONSE_DRAFT

  @@map("ai_task_type")
}

enum AiProcessingStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED

  @@map("ai_processing_status")
}

enum AiDraftStatus {
  GENERATED
  EDITED
  SENT
  DISCARDED

  @@map("ai_draft_status")
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  email             String
  normalizedEmail   String   @unique @map("normalized_email")
  emailVerified     Boolean  @default(true) @map("email_verified")
  image             String?
  role              UserRole
  isActive          Boolean  @default(true) @map("is_active")
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  authorProfile      AuthorProfile?
  sessions           AuthSession[]
  accounts           AuthAccount[]
  assignedTickets    Ticket[]            @relation("AssignedAdmin")
  categoryUpdates    Ticket[]            @relation("CategoryUpdatedBy")
  priorityUpdates    Ticket[]            @relation("PriorityUpdatedBy")
  ticketResponses    TicketResponse[]    @relation("ResponseAuthor")
  internalNotes      InternalNote[]      @relation("InternalNoteAuthor")
  editedAiDrafts     AiDraft[]           @relation("AiDraftEditedBy")
  ticketStatusEvents TicketStatusEvent[] @relation("StatusChangedBy")

  @@index([role, isActive])
  @@map("users")
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("auth_verifications")
}

model AuthRateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("auth_rate_limits")
}

model AuthorProfile {
  authorId   String   @id @map("author_id")
  userId     String   @unique @map("user_id") @db.Uuid
  name       String
  email      String   @unique
  phone      String
  city       String
  joinedDate DateTime @map("joined_date") @db.Date

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  books   Book[]
  tickets Ticket[]

  @@index([joinedDate])
  @@map("author_profiles")
}

model Book {
  bookId                String    @id @map("book_id")
  authorId              String    @map("author_id")
  title                 String
  isbn                  String    @unique
  genre                 String
  publicationDate       DateTime? @map("publication_date") @db.Date
  status                String
  mrp                   Decimal?  @db.Decimal(12, 2)
  authorRoyaltyPerCopy  Decimal?  @map("author_royalty_per_copy") @db.Decimal(12, 2)
  totalCopiesSold       Int       @map("total_copies_sold")
  totalRoyaltyEarned    Decimal   @map("total_royalty_earned") @db.Decimal(14, 2)
  royaltyPaid           Decimal   @map("royalty_paid") @db.Decimal(14, 2)
  royaltyPending        Decimal   @map("royalty_pending") @db.Decimal(14, 2)
  lastRoyaltyPayoutDate DateTime? @map("last_royalty_payout_date") @db.Date
  printPartner          String?   @map("print_partner")
  availableOn           String[]  @default([]) @map("available_on")

  author  AuthorProfile @relation(fields: [authorId], references: [authorId], onDelete: Restrict)
  tickets Ticket[]

  @@unique([bookId, authorId])
  @@index([authorId, status])
  @@index([publicationDate])
  @@map("books")
}

model Ticket {
  id                           String                @id @default(uuid()) @db.Uuid
  creationIdempotencyKey       String?               @unique @map("creation_idempotency_key") @db.Uuid
  authorId                     String                @map("author_id")
  bookId                       String?               @map("book_id")
  subject                      String
  description                  String                @db.Text
  status                       TicketStatus          @default(OPEN)
  category                     TicketCategory?
  priority                     TicketPriority?
  classificationState          ClassificationState   @default(PENDING) @map("classification_state")
  classificationRevision       Int                   @default(0) @map("classification_revision")
  classificationStateUpdatedAt DateTime              @default(now()) @map("classification_state_updated_at") @db.Timestamptz(3)
  categorySource               ClassificationSource? @map("category_source")
  categoryUpdatedAt            DateTime?             @map("category_updated_at") @db.Timestamptz(3)
  categoryUpdatedByUserId      String?               @map("category_updated_by_user_id") @db.Uuid
  prioritySource               ClassificationSource? @map("priority_source")
  priorityUpdatedAt            DateTime?             @map("priority_updated_at") @db.Timestamptz(3)
  priorityUpdatedByUserId      String?               @map("priority_updated_by_user_id") @db.Uuid
  assignedAdminId              String?               @map("assigned_admin_id") @db.Uuid
  assignedAt                   DateTime?             @map("assigned_at") @db.Timestamptz(3)
  createdAt                    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  author            AuthorProfile       @relation(fields: [authorId], references: [authorId], onDelete: Restrict)
  book              Book?               @relation(fields: [bookId, authorId], references: [bookId, authorId], onDelete: Restrict)
  assignedAdmin     User?               @relation("AssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  categoryUpdatedBy User?               @relation("CategoryUpdatedBy", fields: [categoryUpdatedByUserId], references: [id], onDelete: SetNull)
  priorityUpdatedBy User?               @relation("PriorityUpdatedBy", fields: [priorityUpdatedByUserId], references: [id], onDelete: SetNull)
  responses         TicketResponse[]
  internalNotes     InternalNote[]
  aiRuns            AiProcessingRun[]
  aiDrafts          AiDraft[]
  statusEvents      TicketStatusEvent[]

  @@index([authorId, createdAt])
  @@index([bookId])
  @@index([status, priority, createdAt])
  @@index([category, status, createdAt])
  @@index([classificationState, createdAt])
  @@index([assignedAdminId, status])
  @@map("tickets")
}

model TicketResponse {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  sentByUserId String   @map("sent_by_user_id") @db.Uuid
  idempotencyKey String? @unique @map("idempotency_key") @db.Uuid
  aiDraftId    String?  @unique @map("ai_draft_id") @db.Uuid
  body         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ticket  Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sentBy  User     @relation("ResponseAuthor", fields: [sentByUserId], references: [id], onDelete: Restrict)
  aiDraft AiDraft? @relation("DraftSentAsResponse", fields: [aiDraftId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_responses")
}

model InternalNote {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @map("ticket_id") @db.Uuid
  adminUserId String   @map("admin_user_id") @db.Uuid
  body        String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  admin  User   @relation("InternalNoteAuthor", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("internal_notes")
}

model AiProcessingRun {
  id                            String             @id @default(uuid()) @db.Uuid
  ticketId                      String             @map("ticket_id") @db.Uuid
  taskType                      AiTaskType         @map("task_type")
  status                        AiProcessingStatus @default(PENDING)
  classificationRevisionAtStart Int?               @map("classification_revision_at_start")
  provider                      String?
  model                         String?
  promptVersion                 String?            @map("prompt_version")
  knowledgeBaseVersion          String?            @map("knowledge_base_version")
  inputHash                     String?            @map("input_hash")
  providerRequestId             String?            @map("provider_request_id")
  inputTokens                   Int?               @map("input_tokens")
  outputTokens                  Int?               @map("output_tokens")
  latencyMs                     Int?               @map("latency_ms")
  result                        Json?
  errorCode                     String?            @map("error_code")
  errorMessage                  String?            @map("error_message") @db.Text
  startedAt                     DateTime?          @map("started_at") @db.Timestamptz(3)
  completedAt                   DateTime?          @map("completed_at") @db.Timestamptz(3)
  createdAt                     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  ticket Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  draft  AiDraft?

  @@index([ticketId, taskType, createdAt])
  @@index([status, createdAt])
  @@map("ai_processing_runs")
}

model AiDraft {
  id              String        @id @default(uuid()) @db.Uuid
  ticketId        String        @map("ticket_id") @db.Uuid
  processingRunId String?       @unique @map("processing_run_id") @db.Uuid
  generatedBody   String        @map("generated_body") @db.Text
  currentBody     String        @map("current_body") @db.Text
  status          AiDraftStatus @default(GENERATED)
  editedByUserId  String?       @map("edited_by_user_id") @db.Uuid
  editedAt        DateTime?     @map("edited_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  ticket        Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  processingRun AiProcessingRun? @relation(fields: [processingRunId], references: [id], onDelete: Restrict)
  editedBy      User?            @relation("AiDraftEditedBy", fields: [editedByUserId], references: [id], onDelete: SetNull)
  sentResponse  TicketResponse?  @relation("DraftSentAsResponse")

  @@index([ticketId, status, createdAt])
  @@map("ai_drafts")
}

model TicketStatusEvent {
  id              String        @id @default(uuid()) @db.Uuid
  ticketId        String        @map("ticket_id") @db.Uuid
  fromStatus      TicketStatus? @map("from_status")
  toStatus        TicketStatus  @map("to_status")
  changedByUserId String?       @map("changed_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy User?  @relation("StatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_status_events")
}
