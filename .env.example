# PostgreSQL connection used by Prisma on the server only.
DATABASE_URL="postgresql://bookleaf:bookleaf@localhost:5432/bookleaf?schema=public"

# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-at-least-32-random-bytes"

# Exact public origin used to validate cookie-authenticated browser mutations.
# Use the origin you open in the browser; do not include a trailing slash.
BETTER_AUTH_URL="http://localhost:3000"

# Required only by the explicit core seed command. No usable passwords are
# committed, and existing password hashes are never reset by a re-run.
SEED_AUTHOR_PASSWORD="replace-with-a-demo-author-password"
SEED_ADMIN_EMAIL="replace-with-a-demo-admin-email"
SEED_ADMIN_PASSWORD="replace-with-a-demo-admin-password"

# Optional override. The default is prisma/data/bookleaf_sample_data.json.
# BOOKLEAF_SEED_DATA_PATH="/absolute/path/to/bookleaf_sample_data.json"

# Optional server-only AI classification. Gemini 3.5 Flash-Lite has an eligible
# free tier suitable for trial data. Leave provider/key empty to keep ticket
# creation usable with classification marked failed/unavailable. Never prefix
# any key with NEXT_PUBLIC_.
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-3.5-flash-lite"
LLM_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_TIMEOUT_MS="5000"
LLM_MAX_RETRIES="1"
